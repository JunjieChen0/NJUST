# Database configuration
# Copy this file to .env and fill in your values
DATABASE_URL=postgres://postgres:<password>@localhost:5433/evals_development

# Admin authentication - REQUIRED in production
# Generate a strong secret: openssl rand -hex 32
# Must be set to a non-empty, non-default value. Production will fail-closed without it.
EVALS_ADMIN_SECRET=

# Optional: production database for copyRunToProduction
# PRODUCTION_DATABASE_URL=postgres://...
